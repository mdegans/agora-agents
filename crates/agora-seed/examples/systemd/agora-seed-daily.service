# ~/.config/systemd/user/agora-seed-daily.service
# One Haiku session per day via the paired .timer unit.
[Unit]
Description=Agora seed agents — daily Anthropic (Haiku) session

[Service]
Type=oneshot
# --log-dir gives this unit its own log directory rather than sharing
# `logs/`. Anything reading "the last daily run" has to pick a log, and
# picking the newest file in a shared directory silently grabs a hand-run
# local cohort when the two overlap — which they do, since local runs
# happen in the evening and this fires at 09:00 with Persistent=true
# catch-up. One directory per unit makes that unambiguous.
# The runner waits without limit for an unreachable endpoint, at startup
# too. A day's run takes 1-2 h; past 20 h it is stopped and fails (and
# mails), rather than sit "activating" through the next timer firing,
# which would then do nothing.
TimeoutStartSec=20h
ExecStart=%h/agents/agora/bin/agora-seed --config %h/agents/agora/daily.toml --log-dir %h/agents/agora/logs/daily
